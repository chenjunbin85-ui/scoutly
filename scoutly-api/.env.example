# 应用
APP_NAME=threadscout-api
APP_ENV=development
API_KEY=dev-api-key-change-in-production

# 数据库
DATABASE_URL=postgresql+asyncpg://threadscout:threadscout@localhost:5432/threadscout

# Redis
REDIS_URL=redis://localhost:6379/0

# Reddit API（匿名模式不需要填，OAuth 模式需要）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=threadscout:v0.1 by /u/your-username
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_AUTH_MODE=anonymous

# DeepSeek LLM
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# 扫描配置
SCAN_DEFAULT_TIME_FILTER=month
SCAN_MAX_QUERIES=30
SCAN_MAX_CANDIDATES=100
SCAN_REQUEST_INTERVAL=1.5
